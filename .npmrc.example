# Install @pdq/workrail from GitHub Packages.
#
# Copy this file to one of:
#   ~/.npmrc                 - global, applies to all installs from this user
#   <project>/.npmrc         - project-local, only this project sees the auth
#
# Then replace TOKEN below with a GitHub Personal Access Token that has the
# `read:packages` scope. Generate one at:
#   https://github.com/settings/tokens
#
# Do NOT commit the populated file. Add `.npmrc` to your global gitignore if
# you keep it project-local.

@pdq:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=TOKEN
